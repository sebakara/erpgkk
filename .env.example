# ── Database (MySQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gkkerp
DB_USER=root
DB_PASSWORD=secret
# Homebrew MariaDB: leave password empty and set the socket, e.g.
# DB_USER=mavin
# DB_PASSWORD=
# DB_SOCKET=/tmp/mysql.sock

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Redis (Bull queues) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email (SendGrid) ──────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
SENDGRID_FROM=noreply@gkkerp.com

# ── File Storage (AWS S3) ─────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gkkerp-uploads

# ── Push Notifications (Firebase Admin) ───────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Slack ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── GitHub App (read-only engineering activity) ───────
# Create the App at https://github.com/settings/apps/new
# Setup URL: {FRONTEND_URL}/settings?section=integrations
# Webhook URL: {API public URL}/api/integrations/github/webhook
# Permissions: Contents, Issues, Metadata, Pull requests (Read)
# Events: installation, installation_repositories, repository,
#   pull_request, pull_request_review, issues, release, push
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM with literal \n escapes, or a quoted multiline value.
GITHUB_PRIVATE_KEY=
